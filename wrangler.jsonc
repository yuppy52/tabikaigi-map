// 旅会議マップの Cloudflare の設定（API と D1、画面の配信、リアルタイムの部屋（Durable Objects））
{
  "name": "tabikaigi-map",
  "main": "api/src/index.ts",
  // Q-031：2025-04-01 以降（静的アセットの扱いが今の形になった日付）
  "compatibility_date": "2026-08-15",
  // Q-031：workers.dev とプレビューの URL は出さない（独自ドメインだけで公開する）
  "workers_dev": false,
  "preview_urls": false,
  // 画面の配信（architecture の「無料枠を使い切られないために」）。
  // Worker が画面のファイルを読まないので binding は付けない
  "assets": {
    // Vite のビルド結果（npm run build で作る：ADR 0010）
    "directory": "./dist",
    // Q-031：/api/* だけ Worker を通す。画面は Worker を通さずに返す（Worker の枠が尽きても画面は出る）
    "run_worker_first": ["/api/*"],
    // Q-031：ファイルがない URL は Worker を通さず、静的な 404.html を返す
    "not_found_handling": "404-page"
  },
  "vars": {
    // Firebase のプロジェクトID（秘密の値ではない）
    "FIREBASE_PROJECT_ID": "tabikaigi-map"
  },
  // Q-027：自分で書いたログだけ残す。アクセスごとの記録（IP・場所・URL）は切る
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  // グループごとの「部屋」（Durable Objects。リアルタイム：NFR-003）。クラスは api/src/room.ts。
  // Free で使えるのは SQLite 版だけなので new_sqlite_classes で作る（本番に当てた tag は書き換えず、足すときは新しい tag にする）
  "durable_objects": {
    "bindings": [{ "name": "GROUP_ROOM", "class_name": "GroupRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GroupRoom"] }],
  // D1（データベース）。本番のデータベースはまだ作っていない。作ったら database_id を差し替える
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tabikaigi-map",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
