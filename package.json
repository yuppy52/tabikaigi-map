{
  "name": "tabikaigi-map",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --names api,web --kill-others \"wrangler dev\" \"vite\"",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "types": "wrangler types --env-interface Env --include-runtime false api/src/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "sh scripts/deploy.sh"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "~4.1",
    "wrangler": "^4.149.0"
  }
}
