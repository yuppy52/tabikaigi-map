// 試作（小さく試す）用の設定。本番のアプリの設定ではない
{
  "name": "tabikaigi-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/ で始まるものだけ Worker を通す。それ以外（トップ、/g/…）は静的なファイルとして返す
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Firebase のプロジェクトID。2026-10-04 に作った（秘密の値ではない）
    "FIREBASE_PROJECT_ID": "tabikaigi-map"
  },
  "observability": { "enabled": true },
  // グループごとの「部屋」（Durable Object）。Free で使えるのは SQLite 版だけなので new_sqlite_classes で作る
  "durable_objects": {
    "bindings": [{ "name": "GROUP_ROOM", "class_name": "GroupRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GroupRoom"] }],
  // D1（データベース）。いまはローカルで試すだけ。本番に作ったら database_id を差し替える
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tabikaigi-spike",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
